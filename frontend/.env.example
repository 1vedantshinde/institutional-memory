# Copy to .env.local and adjust. Values below are the defaults the code falls
# back to when a variable is unset. Keep each line non-empty: an empty value
# (e.g. `VITE_CHAT_API_URL=`) overrides the fallback with "".

# Chat server (server.py) — POST /chat, GET /chat/status. Also the /chat-api dev-proxy target.
VITE_CHAT_API_URL=http://localhost:8000

# Core API (api/main.py) — /ingest /profile /analyse /query /config. Also the /core-api dev-proxy target.
VITE_CORE_API_URL=http://localhost:8001

# Default dataset folder pre-filled on the Dataset Health page (path as seen by the core API).
VITE_DEFAULT_DATASET_PATH=dataset/Readngs_DAQ_Data

# Default domain config pre-filled on the Dataset Health page (path as seen by the core API).
VITE_DEFAULT_CONFIG_PATH=config/domain.yaml

# "true" serves every API call from MSW mocks in the browser; no backend needed.
VITE_USE_MOCKS=false

# "true" shows the preview pages for not-yet-implemented endpoints (Waveforms, Tool Wear). Mock data only.
VITE_ENABLE_PROPOSED=false

# Dev-server port (default 5173). Backends must allow this origin in CORSMiddleware.
PORT=5173
