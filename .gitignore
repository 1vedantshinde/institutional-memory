# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments and local interpreter settings
.venv/
venv/
env/
ENV/
.python-version

# Local configuration and secrets
.env
.env.*



# Raw multi-gigabyte DAQ dataset and evaluation dumps (mounted or provided separately)
data/
datasets/
dataset/
emaildata/
eval_mail/
runtime/
runtime/daq_cache/
.daq_cache/

# Allow essential knowledge documents, machine maintenance emails, and ML model artifacts
!knowledge_docs/
!knowledge_docs/**
!artifacts/
!artifacts/tool_wear/
!artifacts/tool_wear/**
!quarantine/
!quarantine/quarantine_log.jsonl

# Raw and processed data formats
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
*.msg
*.mbox
*.bin
*.pt
*.pth
*.onnx

# Allow machine emails and specific JSON/JSONL fixtures
!knowledge_docs/emails/*.eml
!quarantine/quarantine_log.jsonl
!artifacts/tool_wear/evaluation.json
!artifacts/tool_wear/model.joblib

# Local API uploads, except committed test fixture
uploads/*
!uploads/test_sop.pdf

# Editor and operating-system files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Frontend (see frontend/.gitignore for the full list)
node_modules/
frontend/dist/
frontend/coverage/
frontend/node_modules/


