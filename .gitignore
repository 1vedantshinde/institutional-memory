# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments and local interpreter settings
.venv/
venv/
env/
ENV/
.python-version

# Local configuration and secrets
.env
.env.*
!.env.example

# Runtime DAQ artifacts: source data must be mounted or provided separately.
data/
datasets/
dataset/
quarantine/quarantine_log.jsonl
artifacts/
runtime/daq_cache/

# Local API uploads, except the committed test fixture
uploads/*
!uploads/test_sop.pdf

# Editor and operating-system files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Frontend (see frontend/.gitignore for the full list)
node_modules/
frontend/dist/
frontend/coverage/


