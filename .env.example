# Copy to .env and fill in your values. Never commit .env to git.

# --- LLM ---
# Options: mock | anthropic
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- Embeddings ---
# Set to 1 to use all-MiniLM-L6-v2 (requires: pip install sentence-transformers + one-time model download)
# IMPORTANT: change EMBEDDING_DIM to 384 and re-ingest all documents when flipping this flag
USE_NEURAL_MODELS=0
EMBEDDING_DIM=1536

# --- Vector Store (Qdrant) ---
# Leave empty to use the in-memory mock; set to activate real Qdrant
# QDRANT_URL=http://localhost:6333

# --- Graph Store (Neo4j) ---
# Leave empty to use the in-memory simulation; set to activate real Neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=testpassword

# --- API Security ---
# Set to a random secret to enable X-API-Key header enforcement on /ingest and /config
# Leave empty to disable auth (fine for local dev)
API_KEY=
