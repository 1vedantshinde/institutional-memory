# Copy to .env and fill in your values. Never commit .env to git.

# --- LLM: select exactly one provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.8-flash
# Retry a transient Gemini 429/5xx failure twice (three total attempts).
GEMINI_MAX_RETRIES=2
# Optional: tried in order when GEMINI_MODEL is temporarily unavailable (503/429).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-lite-latest

# Alternative providers:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace_with_your_key
# OPENAI_MODEL=gpt-6-astra
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace_with_your_key
# (mock is for tests only; the DAQ query path refuses to answer with it)

# --- DAQ dataset (defaults shown) ---
# DAQ_DATASET_ROOT=dataset/Readngs_DAQ_Data
# DAQ_CONFIG_PATH=config/domain.yaml
# Set to 0 to skip loading the dataset inventory when server.py starts.
# DAQ_WARM_START=1

# --- Document knowledge base: embeddings ---
# Set to 1 to use all-MiniLM-L6-v2 (requires: pip install sentence-transformers + one-time model download)
# IMPORTANT: change EMBEDDING_DIM to 384 and re-ingest all documents when flipping this flag
USE_NEURAL_MODELS=0
EMBEDDING_DIM=1536

# --- Vector Store (Qdrant) ---
# Leave empty to use the in-memory mock; set to activate real Qdrant
# QDRANT_URL=http://localhost:6333

# --- Graph Store (Neo4j) ---
# Leave empty to use the in-memory simulation; set to activate real Neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=testpassword

# --- API Security ---
# Set to a random secret to require an X-API-Key header on write endpoints
# (/ingest, /ingest-folder, /analyse, PUT /config, legacy ingest). The web app
# does not send this header yet, so leave empty for local use.
API_KEY=
