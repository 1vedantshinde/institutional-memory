# Copy to .env and select exactly one provider. Do not commit the real .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.8-flash
# Retry a transient Gemini 429/5xx failure twice (three total attempts).
GEMINI_MAX_RETRIES=2

# Alternative provider:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace_with_your_key
# OPENAI_MODEL=gpt-6-astra
